{
  "sampling_rate_hz": 100,
  "epoch_seconds": 30,
  "n_classes": 5,
  "d_model": 96,
  "cnn_channels": 32,
  "kernel_sizes": [15, 31, 63],
  "temporal_stride": 8,
  "sequence_model": "gru",
  "sequence_layers": 1,
  "channel_pool": "attention",
  "dropout": 0.15,
  "bottleneck_dim": 32,
  "structure_loss_weight": 0.05,
  "bag_consistency_weight": 0.03,
  "structure_temperature": 0.15,
  "self_supervised_temperature": 0.20,
  "temporal_max_shift_samples": 16,
  "temporal_mask_fraction": 0.05,
  "temporal_noise_std": 0.03,
  "frequency_dropout_probability": 0.08,
  "frequency_amplitude_jitter_std": 0.05,
  "self_supervised_training": {
    "source_dataset": "Sleep-EDF",
    "record_count": 64,
    "epoch_eligibility": {
      "accepted_source_array_layouts": ["epoch_time", "epoch_channel_time"],
      "minimum_time_samples": 2,
      "all_values_finite": true,
      "per_channel_standard_deviation_strictly_greater_than": 1e-8
    },
    "uses_sleep_stage_annotations": false,
    "max_epochs_per_record": 300,
    "selection": "deterministic_evenly_spaced_chronological",
    "batch_size": 64,
    "training_epochs": 2,
    "validation_split": "participant_disjoint",
    "checkpoint_selection": "minimum_validation_contrastive_loss"
  },
  "longitudinal_feedback_evaluation": {
    "membership_output_classes": 4,
    "task_valid_classes": {
      "LR": [1, 2],
      "UD": [3, 4],
      "2D": [1, 2, 3, 4]
    },
    "window_to_trial_membership": "mean_four_class_vector_before_task_valid_ratio",
    "trial_score": "target_membership_divided_by_task_valid_membership_sum",
    "within_training_run_aggregation": "equal_weight_across_held_out_trials",
    "across_training_run_aggregation": "equal_weight_across_predefined_runs",
    "session1_gate_b_transform": "unranked_task_valid_membership",
    "outer_fold_missing_score": "outer_training_median",
    "outer_fold_score_transform": "outer_training_empirical_midrank",
    "test_midrank_mapping": "training_count_below_plus_half_equal_divided_by_n_train",
    "outer_fold_standardization": "training_mean_and_population_standard_deviation",
    "reduced_model": ["intercept", "experimental_group"],
    "full_model_addition": "task_matched_feedback_score"
  }
}
